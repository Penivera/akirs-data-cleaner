# Primary payment provider for NUBAN resolution
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here

# Fallback payment provider (used automatically when Paystack fails or key is missing)
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key_here

# Bearer token for the live AKIRS TMS intelligence database
INTELLIGENCE_TOKEN=your_intelligence_token_here

# --- Authentication & Admin -------------------------------------------------

# Secret used to sign JWT access/refresh tokens and admin sessions. CHANGE THIS.
SECRET_KEY=replace-with-a-long-random-secret

# Deployment environment: development or production. Production refuses to
# start with a SQLite DATABASE_URL.
APP_ENV=production

# SQLAlchemy database URL. In production this MUST be a PostgreSQL URL; the
# async driver is appended automatically if missing (postgresql://... becomes
# postgresql+asyncpg://...). SQLite (+aiosqlite) is only allowed for development.
DATABASE_URL=postgresql://akirs:akirs@db:5432/akirs

# Superuser seeded on first startup (only when the users table is empty).
ADMIN_EMAIL=admin@akirs.local
# If left blank, a random password is generated and printed to the logs once.
ADMIN_PASSWORD=devon

# JWT lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Starlette Admin session cookie
ADMIN_SESSION_MAX_AGE=1209600
ADMIN_SESSION_HTTPS_ONLY=false

# --- Two-factor authentication (TOTP) ---------------------------------------

# Issuer name shown in authenticator apps.
TOTP_ISSUER=AKIRS Data Toolkit
# Lifetime of the short-lived login challenge token, in minutes.
MFA_CHALLENGE_EXPIRE_MINUTES=10
# Number of one-time recovery codes issued when a user enables 2FA.
RECOVERY_CODE_COUNT=10

# --- File handling -----------------------------------------------------------

# Maximum upload file size in megabytes.
MAX_UPLOAD_SIZE_MB=50

# Comma-separated list of allowed file extensions.
ALLOWED_EXTENSIONS=.xlsx,.xls,.csv

# --- Cleanup job -------------------------------------------------------------

# Enable/disable the automatic cleanup of stale files.
CLEANUP_ENABLED=true

# Files older than this many hours will be deleted by the cleanup job.
CLEANUP_MAX_AGE_HOURS=24

# How often the cleanup job runs, in hours.
CLEANUP_INTERVAL_HOURS=24

# --- Performance -------------------------------------------------------------

# Size of the dedicated thread pool for CPU-bound file processing. Files are
# parsed off the async event loop so a single worker stays responsive. Keep this
# small: each concurrent job can load a whole workbook into memory.
PROCESSING_THREADS=2

# Number of Gunicorn worker processes (Docker deploy). State is stored in the
# database (SQLite) and shared across workers, so this can be scaled up.
WORKERS=2
